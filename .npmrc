# Project-specific npm configuration
# Resolves SSL certificate issues with antivirus software (Norton, etc.)
# that intercept HTTPS traffic and break Node's bundled CA certificates

# Use system certificate store instead of Node's bundled certs
# This allows antivirus SSL scanning to work properly
# NOTE: use-system-ca is deprecated, use NODE_OPTIONS instead
node-options=--use-system-ca

# Registry settings for faster installs
registry=https://registry.npmjs.org/
fetch-timeout=60000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Alternative: If SSL issues persist, temporarily use (not recommended for production)
# strict-ssl=false
