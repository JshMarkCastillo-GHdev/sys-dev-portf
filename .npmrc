# Project-specific npm configuration
# Resolves SSL certificate issues with antivirus software (Norton, etc.)
# that intercept HTTPS traffic and break Node's bundled CA certificates

# Use system certificate store instead of Node's bundled certs
# This allows antivirus SSL scanning to work properly
use-system-ca=true

# Alternative: If use-system-ca doesn't work on older npm versions,
# temporarily uncomment the line below (not recommended for production)
# strict-ssl=false
